          },
          "decimals": 1
        },
        "measure_temperature.tempoutdoor": {
          "title": {
            "en": "Outdoor Temperature",
            "nl": "Buiten temperatuur"
          },
          "decimals": 1
        },
        "measure_temperature.temppipein": {
          "title": {
